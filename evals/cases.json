{
  "_comment": [
    "Declarative eval cases for the one exposed tool.",
    "",
    "These are the F1 gate: they run offline with no model and no API key, so",
    "CI is green and honest. F2 replaces them with promptfoo trajectory evals",
    "that score a real agent; until that exists, this is what 'the eval gate'",
    "actually means here, and the pipeline does not pretend otherwise.",
    "",
    "Each case asserts on the tool boundary - what an agent would receive - not",
    "on internal functions, so the cases stay valid if the internals move.",
    "",
    "expect_absent is the interesting field: a case that passes while leaking a",
    "secret into a reason is a failure, and no positive assertion would catch it."
  ],
  "cases": [
    {
      "name": "healthy interface is reported ok",
      "command": "srl_interface_brief",
      "arguments": { "interface": "ethernet-1/1" },
      "output_ref": "SRL_INTERFACE_UP",
      "expect_ok": true,
      "expect_reasons_empty": true
    },
    {
      "name": "down interface is not reported ok",
      "command": "srl_interface_brief",
      "arguments": { "interface": "ethernet-1/1" },
      "output_ref": "SRL_INTERFACE_DOWN",
      "expect_ok": false
    },
    {
      "name": "absent interface does not pass by default",
      "command": "srl_interface_brief",
      "arguments": { "interface": "ethernet-9/9" },
      "output_ref": "SRL_INTERFACE_UP",
      "expect_ok": false
    },
    {
      "name": "full OSPF adjacency is ok",
      "command": "srl_ospf_neighbor",
      "arguments": { "neighbor_router_id": "10.1.12.2" },
      "output_ref": "SRL_OSPF_FULL",
      "expect_ok": true
    },
    {
      "name": "exstart adjacency is not ok",
      "command": "srl_ospf_neighbor",
      "arguments": { "neighbor_router_id": "10.1.12.2" },
      "output_ref": "SRL_OSPF_NOT_FULL",
      "expect_ok": false
    },
    {
      "name": "full state with a bad neighbour is not ok",
      "command": "srl_ospf_neighbor",
      "arguments": { "neighbor_router_id": "10.1.12.2" },
      "output_ref": "SRL_OSPF_FULL_BUT_BAD_NEIGHBOR",
      "expect_ok": false
    },
    {
      "name": "established BGP peer is ok",
      "command": "srl_bgp_neighbor_detail",
      "arguments": { "peer_ip": "10.1.13.2", "remote_as": "65002" },
      "output_ref": "SRL_BGP_ESTABLISHED",
      "expect_ok": true
    },
    {
      "name": "active BGP peer is not ok",
      "command": "srl_bgp_neighbor_detail",
      "arguments": { "peer_ip": "10.1.13.2", "remote_as": "65002" },
      "output_ref": "SRL_BGP_ACTIVE",
      "expect_ok": false
    },
    {
      "name": "peer established against the wrong AS is not ok",
      "command": "srl_bgp_neighbor_detail",
      "arguments": { "peer_ip": "10.1.13.2", "remote_as": "65099" },
      "output_ref": "SRL_BGP_ESTABLISHED",
      "expect_ok": false
    },
    {
      "name": "healthy FRR summary is ok",
      "command": "frr_bgp_summary",
      "arguments": {},
      "output_ref": "FRR_SUMMARY_HEALTHY",
      "expect_ok": true
    },
    {
      "name": "FRR peer with zero received prefixes is not ok",
      "command": "frr_bgp_summary",
      "arguments": {},
      "output_ref": "FRR_SUMMARY_UNHEALTHY",
      "expect_ok": false
    },
    {
      "name": "FRR with zero peers is never reported healthy",
      "command": "frr_bgp_summary",
      "arguments": {},
      "output_ref": "FRR_SUMMARY_EMPTY",
      "expect_ok": false
    },
    {
      "name": "malformed FRR payload is an input error, not a network fault",
      "command": "frr_bgp_summary",
      "arguments": {},
      "output_ref": "FRR_SUMMARY_MALFORMED",
      "expect_ok": false,
      "expect_contains": ["input error"]
    },
    {
      "name": "installed route is ok",
      "command": "srl_route_detail",
      "arguments": { "prefix": "10.0.0.2/32" },
      "output_ref": "SRL_ROUTE_INSTALLED",
      "expect_ok": true
    },
    {
      "name": "missing route is not ok even though the prefix is echoed",
      "command": "srl_route_detail",
      "arguments": { "prefix": "10.0.0.2/32" },
      "output_ref": "SRL_ROUTE_MISSING",
      "expect_ok": false
    },
    {
      "name": "reachable ping is ok",
      "command": "ping",
      "arguments": {},
      "output_ref": "PING_OK",
      "expect_ok": true
    },
    {
      "name": "total packet loss is not ok",
      "command": "ping",
      "arguments": {},
      "output_ref": "PING_TOTAL_LOSS",
      "expect_ok": false
    },
    {
      "name": "a credential in device output never reaches a reason",
      "command": "srl_route_detail",
      "arguments": { "prefix": "9.9.9.9/32" },
      "output_ref": "SRL_ROUTE_INSTALLED_WITH_SECRET",
      "expect_ok": false,
      "expect_absent": ["hunter2"]
    },
    {
      "name": "an out-of-scope command is refused",
      "command": "configure",
      "arguments": {},
      "output_ref": "SRL_INTERFACE_UP",
      "expect_error_contains": "not in the allowlist"
    },
    {
      "name": "a raw CLI string is refused rather than parsed",
      "command": "show interface brief",
      "arguments": {},
      "output_ref": "SRL_INTERFACE_UP",
      "expect_error_contains": "not in the allowlist"
    },
    {
      "name": "a missing required argument is refused",
      "command": "srl_interface_brief",
      "arguments": {},
      "output_ref": "SRL_INTERFACE_UP",
      "expect_error_contains": "requires argument"
    },
    {
      "name": "an argument invalid for the chosen command is refused, not dropped",
      "command": "srl_interface_brief",
      "arguments": { "interface": "ethernet-1/1", "prefix": "10.0.0.2/32" },
      "output_ref": "SRL_INTERFACE_UP",
      "expect_error_contains": "does not accept"
    }
  ]
}
